# Required by the Vite frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_APP_ENV=production

# Compile-time release gates. V1.1 remains fully closed. The V1.2 Feedback
# Intelligence client enables structured checkpoints and the independent,
# separately consented text path together.
VITE_RELEASE_LINE=1.1
VITE_FEEDBACK_INTELLIGENCE_V1_ENABLED=false
VITE_FEEDBACK_TEXT_V1_ENABLED=false
VITE_TURNSTILE_SITE_KEY=
# Public website only. Keep false for local, Preview and native app builds.
VITE_WEB_ANALYTICS_ENABLED=false

# Required by Supabase Edge Functions
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public organization inquiry Edge Function. Production remains fail-closed
# until the migration, Turnstile widget and explicit enable flag are verified.
ORGANIZATION_INQUIRY_PUBLIC_ENABLED=false
ORGANIZATION_INQUIRY_ALLOWED_ORIGINS=https://rewireperform.com,https://www.rewireperform.com
TURNSTILE_SECRET_KEY=

# Required by the minor/guardian authorization Edge Functions
APP_PUBLIC_URL=https://rewireperform.com
GUARDIAN_ALLOWED_ORIGINS=https://rewireperform.com,https://www.rewireperform.com
GUARDIAN_EMAIL_ENCRYPTION_KEY_B64=
GUARDIAN_EMAIL_HASH_KEY=
GUARDIAN_EMAIL_FROM="RewirePerform Support <support@auth.rewireperform.com>"
RESEND_API_KEY=

# Required only if push notifications are enabled
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rewireperform.com
