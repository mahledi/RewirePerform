{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mahles-jarvis:rewire-feedback-intelligence-structured-export:1.2.0-draft",
  "title": "PROPOSED_AWAITING_PRODUCER_CONFIRMATION",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "contract_status", "generated_at", "items", "privacy"],
  "properties": {
    "schema_version": {"const": "rewire-feedback-intelligence-structured-export-v1.2.0-draft"},
    "contract_version": {"const": "1.2.0-structured-only-draft"},
    "contract_status": {"const": "PROPOSED_AWAITING_PRODUCER_CONFIRMATION"},
    "generated_at": {"type": "string", "format": "date-time"},
    "items": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/item"}},
    "privacy": {"$ref": "#/$defs/privacy"}
  },
  "$defs": {
    "hashReference": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_reference", "questionnaire_version", "language", "product_version", "content_version", "program_day", "question_id", "construct_id", "item_family_id", "item_variant_id", "scale_id", "structured_answer", "activity_snapshot"],
      "properties": {
        "subject_reference": {"$ref": "#/$defs/hashReference"},
        "questionnaire_version": {"$ref": "#/$defs/safeId"},
        "language": {"const": "de-DE"},
        "product_version": {"$ref": "#/$defs/safeId"},
        "content_version": {"$ref": "#/$defs/safeId"},
        "program_day": {"enum": [10, 24, 39, 55]},
        "question_id": {"$ref": "#/$defs/safeId"},
        "construct_id": {"$ref": "#/$defs/safeId"},
        "item_family_id": {"$ref": "#/$defs/safeId"},
        "item_variant_id": {"$ref": "#/$defs/safeId"},
        "scale_id": {"$ref": "#/$defs/safeId"},
        "structured_answer": {"$ref": "#/$defs/safeId"},
        "activity_snapshot": {"$ref": "#/$defs/activitySnapshot"}
      }
    },
    "activitySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_window", "program_days_available", "program_days_completed", "checkins_completed", "journal_entries_created_count", "tasks_completed", "transfer_pulse_count", "resume_delay_bucket", "continuation_status_bucket"],
      "properties": {
        "observation_window": {"$ref": "#/$defs/observationWindow"},
        "program_days_available": {"type": "integer", "minimum": 0, "maximum": 56},
        "program_days_completed": {"type": "integer", "minimum": 0, "maximum": 56},
        "checkins_completed": {"type": "integer", "minimum": 0, "maximum": 56},
        "journal_entries_created_count": {"type": "integer", "minimum": 0, "maximum": 56},
        "tasks_completed": {"type": "integer", "minimum": 0, "maximum": 1000},
        "transfer_pulse_count": {"type": "integer", "minimum": 0, "maximum": 15},
        "resume_delay_bucket": {"enum": ["NO_RESUME_NEEDED", "DAYS_1_3", "DAYS_4_7", "DAYS_8_PLUS", "NOT_AVAILABLE"]},
        "continuation_status_bucket": {"enum": ["ACTIVE_OR_COMPLETED", "PAUSED_1_3_DAYS", "PAUSED_4_7_DAYS", "PAUSED_8_PLUS_DAYS", "NOT_AVAILABLE"]}
      }
    },
    "observationWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_program_day", "end_program_day", "bucket"],
      "properties": {
        "start_program_day": {"const": 1},
        "end_program_day": {"enum": [10, 24, 39, 55]},
        "bucket": {"enum": ["DAY_01_10", "DAY_01_24", "DAY_01_39", "DAY_01_55"]}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_text_in_contract", "text_consent_payload_in_contract", "direct_identifiers_exported", "journal_reflection_support_text_exported", "coach_team_data_exported", "subject_reference_handling", "minimum_group_size", "small_groups_suppressed", "model_training", "automated_individual_decisions", "observational_not_causal"],
      "properties": {
        "raw_text_in_contract": {"const": false},
        "text_consent_payload_in_contract": {"const": false},
        "direct_identifiers_exported": {"const": false},
        "journal_reflection_support_text_exported": {"const": false},
        "coach_team_data_exported": {"const": false},
        "subject_reference_handling": {"const": "IN_MEMORY_ONLY_NEVER_OUTPUT_OR_PERSIST"},
        "minimum_group_size": {"const": 5},
        "small_groups_suppressed": {"const": true},
        "model_training": {"const": false},
        "automated_individual_decisions": {"const": false},
        "observational_not_causal": {"const": true}
      }
    }
  }
}
