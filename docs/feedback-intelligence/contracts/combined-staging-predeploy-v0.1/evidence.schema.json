{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewireperform.local/contracts/feedback-intelligence/combined-staging-predeploy-v0.1/evidence.schema.json",
  "title": "Feedback Intelligence combined Staging predeploy evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_status",
    "generated_at",
    "target",
    "producer_inputs",
    "staging_payload",
    "historical_evidence",
    "gates",
    "next_gate"
  ],
  "properties": {
    "schema_version": {
      "const": "rewireperform-feedback-intelligence-combined-staging-predeploy-v1"
    },
    "evidence_status": {
      "const": "PREPARED_FAIL_CLOSED_AWAITING_SEPARATE_STAGING_APPLY"
    },
    "generated_at": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_ref", "environment", "jurisdiction", "data_scope"],
      "properties": {
        "project_ref": { "const": "zbeswjipayspgvcipzmx" },
        "environment": { "const": "staging" },
        "jurisdiction": { "const": "DE" },
        "data_scope": { "const": "synthetic_only" }
      }
    },
    "producer_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantics", "export", "gateway"],
      "properties": {
        "semantics": { "$ref": "#/$defs/inputPin" },
        "export": { "$ref": "#/$defs/inputPin" },
        "gateway": { "$ref": "#/$defs/inputPin" }
      }
    },
    "staging_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migrations", "edge"],
      "properties": {
        "migrations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "status"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "status": { "const": "NOT_APPLIED_BY_THIS_GATE" }
            }
          }
        },
        "edge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slug", "source_sha256", "status", "verify_jwt"],
          "properties": {
            "slug": { "const": "mahleos-feedback-intelligence-read" },
            "source_sha256": { "$ref": "#/$defs/sha256" },
            "status": { "const": "NOT_DEPLOYED_BY_THIS_GATE" },
            "verify_jwt": { "const": false }
          }
        }
      }
    },
    "historical_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v0_3_1_authorizes_v0_3_2",
        "v0_2_0_authorizes_v0_2_1",
        "prior_gateway_authorizes_combined_gate",
        "historical_bytes_preserved"
      ],
      "properties": {
        "v0_3_1_authorizes_v0_3_2": { "const": false },
        "v0_2_0_authorizes_v0_2_1": { "const": false },
        "prior_gateway_authorizes_combined_gate": { "const": false },
        "historical_bytes_preserved": { "const": true }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feedback_collection_enabled",
        "text_collection_enabled",
        "minor_policy_enabled",
        "guardian_policy_enabled",
        "consumer_pin_enabled",
        "synthetic_export_enabled",
        "reader_password_provisioned",
        "machine_key_provisioned",
        "edge_runtime_enabled",
        "network_read_performed",
        "production_export_enabled",
        "real_data_read_enabled",
        "database_write_performed",
        "push_performed",
        "merge_performed",
        "app_store_release_authorized"
      ],
      "properties": {
        "feedback_collection_enabled": { "const": false },
        "text_collection_enabled": { "const": false },
        "minor_policy_enabled": { "const": false },
        "guardian_policy_enabled": { "const": false },
        "consumer_pin_enabled": { "const": false },
        "synthetic_export_enabled": { "const": false },
        "reader_password_provisioned": { "const": false },
        "machine_key_provisioned": { "const": false },
        "edge_runtime_enabled": { "const": false },
        "network_read_performed": { "const": false },
        "production_export_enabled": { "const": false },
        "real_data_read_enabled": { "const": false },
        "database_write_performed": { "const": false },
        "push_performed": { "const": false },
        "merge_performed": { "const": false },
        "app_store_release_authorized": { "const": false }
      }
    },
    "next_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "separate_staging_apply_approval_required",
        "metadata_only_postdeploy_assurance_required",
        "credentials_allowed",
        "network_read_allowed",
        "production_allowed"
      ],
      "properties": {
        "decision": { "const": "READY_FOR_SEPARATELY_APPROVED_METADATA_ONLY_STAGING_APPLY" },
        "separate_staging_apply_approval_required": { "const": true },
        "metadata_only_postdeploy_assurance_required": { "const": true },
        "credentials_allowed": { "const": false },
        "network_read_allowed": { "const": false },
        "production_allowed": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "inputPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "producer_commit",
        "manifest_sha256",
        "package_sha256",
        "consumer_commit",
        "consumer_acceptance_sha256",
        "consumer_status"
      ],
      "properties": {
        "contract_version": { "type": "string", "minLength": 1 },
        "producer_commit": { "$ref": "#/$defs/commit" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "package_sha256": { "$ref": "#/$defs/sha256" },
        "consumer_commit": { "$ref": "#/$defs/commit" },
        "consumer_acceptance_sha256": { "$ref": "#/$defs/sha256" },
        "consumer_status": { "const": "ACCEPTED_LOCAL_UNSIGNED_AWAITING_COMBINED_STAGING_ASSURANCE" }
      }
    }
  }
}
