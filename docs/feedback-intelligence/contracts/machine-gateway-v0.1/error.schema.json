{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rewireperform:feedback-intelligence-machine-gateway-error:0.1.0-draft",
  "title": "Feedback Intelligence machine gateway error v0.1 draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "enum": [
        "method_not_allowed",
        "service_not_configured",
        "unauthorized",
        "machine_gate_closed",
        "unsupported_media_type",
        "invalid_replay_headers",
        "request_too_large",
        "invalid_request",
        "invalid_json",
        "contract_drift",
        "production_scope_blocked",
        "replay_detected",
        "stale_request",
        "rate_limited",
        "feedback_read_unavailable",
        "response_too_large"
      ]
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
