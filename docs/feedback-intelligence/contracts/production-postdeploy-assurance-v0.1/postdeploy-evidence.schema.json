            "secret_values_persisted": {
              "const": false
            },
            "unrelated_secret_names_persisted": {
              "const": false
            }
          }
        },
        "reader_role_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "observation_sha256",
            "role_name",
            "password_is_null",
            "application_rows_read"
