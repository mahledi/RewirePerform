                },
                "MAHLEOS_FEEDBACK_PRODUCTION_READER_DATABASE_URL": {
                  "const": false
                },
                "MAHLEOS_FEEDBACK_PRODUCTION_MACHINE_GATE": {
                  "const": false
                },
                "MAHLEOS_FEEDBACK_PRODUCTION_REAL_DATA_GATE": {
                  "const": false
